{
  "expo": {
    "name": "Magnolia Ebru",
    "slug": "magnolia-vexo",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icons/app-icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/key-art/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0e1a1f"
    },
    "android": {
      "package": "com.magnoliavexo.magnoliaebru",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-background.png",
        "backgroundColor": "#0e1a1f"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "allowBackup": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "./plugins/withLocalWeb",
      "./plugins/withReleaseHardening"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "extra": {
      "gameSlug": "ebru",
      "offlineFirst": true,
      "company": "MAGNOLIA VEXO",
      "eas": {
        "projectId": "918ae6be-f044-4d90-a4aa-6435a101caef"
      }
    },
    "owner": "894-895"
  }
}
