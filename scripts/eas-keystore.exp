# Downloads the EAS upload keystore to credentials/android/keystore.jks (and credentials.json) without manual menu picks.
# Run from the game folder:  /usr/bin/expect scripts/eas-keystore.exp
# Menu order: profile (base, preview, production) -> credentials.json (4th item) -> Download (1st item).
set timeout 120
log_user 0
spawn npx --yes eas-cli@latest credentials -p android
proc downs {n} { for {set i 0} {$i < $n} {incr i} { send "\033\[B"; after 400 } }
expect -re "build profile" { } timeout { puts "keystore: no profile menu"; exit 2 }
after 1000; downs 2; send "\r"
expect -re "Using build profile: \[^\r\n\]*production" { } timeout { puts "keystore: production not selected"; exit 2 }
expect -re "What do you want to do"
after 1000; downs 3; send "\r"
expect -re "Download credentials from EAS"
after 3000; send "\r"
set tries 0
expect {
  -re "✔\[^\r\n\]*Download credentials from EAS" { }
  timeout { if {[incr tries] < 3} { send "\r"; exp_continue } else { puts "keystore: download not confirmed"; exit 3 } }
}
after 3000
send "\003"
expect eof
if {[file exists credentials/android/keystore.jks]} { puts "keystore: downloaded" } else { puts "keystore: file missing"; exit 4 }
